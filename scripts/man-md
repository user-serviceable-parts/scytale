#!/bin/sh
# Renders scytale-cli/scytale.1 as Markdown, for reading on GitHub,
# into scytale-cli/scytale.1.md. The troff is the source; this file
# is generated, and CI checks it is current. Requires pandoc.

set -eu
cd "$(dirname "$0")/.."

{
    echo "<!-- Generated from scytale.1 by scripts/man-md; edit that. -->"
    echo
    echo "# scytale(1)"
    echo
    # Unwrapped, and with the space that `.BI` leaves inside a bold
    # span moved outside it: pandoc 3.1 writes `**-k ***key*` where
    # 3.7 writes `**-k** *key*`, and wraps lines around the choice.
    # Both are Debian's at some time, and the file must come out the
    # same from either.
    pandoc -f man -t gfm --wrap=none scytale-cli/scytale.1 \
        | sed 's/^# /## /; s/ \*\*\*/** */g'
} > scytale-cli/scytale.1.md
